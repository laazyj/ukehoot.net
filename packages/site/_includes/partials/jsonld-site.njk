{% set founders = site.team | withRole("co-founder") %}
{% set builders = site.team | withRole("builder") %}
{% set maintainers = site.team | withRole("maintainer") %}
{% set jamWhen = site.meet.time | nextWeekly("Wednesday") %}
{% set gigWhen = site.gig.time | nextMonthly("Saturday", 3) %}
{% set eventImage = site.url + site.defaultOgImage %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": {{ site.title | dump | safe }},
      "description": {{ site.description | dump | safe }},
      "inLanguage": "{{ site.language }}",
      "publisher": { "@id": "{{ site.author.id }}" }{% if builders.length %},
      "creator": {{ builders | idRefs | dump | safe }}{% endif %}{% if maintainers.length %},
      "maintainer": {{ maintainers | idRefs | dump | safe }}{% endif %}
    },
    {
      "@type": ["Organization", "MusicGroup"],
      "@id": "{{ site.author.id }}",
      "name": {{ site.author.name | dump | safe }},
      "url": "{{ site.url }}/",
      "description": {{ site.description | dump | safe }},
      "areaServed": "Edinburgh, Scotland"{% if founders.length %},
      "founder": {{ founders | idRefs | dump | safe }}{% endif %}{% if site.meet.venue %},
      "location": {
        "@type": "Place",
        "name": {{ site.meet.venue | dump | safe }}{% if site.meet.address %},
        "address": {{ site.meet.address | dump | safe }}{% endif %}
      }{% endif %},
      "sameAs": {{ [site.social.facebook, site.social.instagram, site.social.youtube] | compact | dump | safe }}
    }{% for p in site.team %},
    {{ p | personNode | dump | safe }}{% endfor %}{% if site.meet.venue %},
    {
      "@type": "Event",
      "@id": "{{ site.url }}/#jam",
      "name": "UkeHoot weekly ukulele jam",
      "description": "Edinburgh's weekly ukulele singalong. All levels welcome, no audition, bring a uke or borrow one.",{% if jamWhen %}
      "startDate": "{{ jamWhen.start }}",
      "endDate": "{{ jamWhen.end }}",{% endif %}
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "isAccessibleForFree": true,
      "image": [{{ eventImage | dump | safe }}],
      "inLanguage": "{{ site.language }}",
      "organizer": { "@id": "{{ site.author.id }}" },
      "performer": { "@id": "{{ site.author.id }}" },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "GBP",
        "availability": "https://schema.org/InStock",
        "url": "{{ site.url }}/"{% if jamWhen %},
        "validFrom": "{{ jamWhen.start }}"{% endif %}
      },
      "location": {
        "@type": "Place",
        "name": {{ site.meet.venue | dump | safe }}{% if site.meet.address %},
        "address": {{ site.meet.address | dump | safe }}{% endif %}
      },
      "eventSchedule": {
        "@type": "Schedule",
        "byDay": "https://schema.org/Wednesday",
        "repeatFrequency": "P1W",
        "startTime": "{{ site.meet.time | time24 }}",
        "scheduleTimezone": "Europe/London"
      }
    }{% endif %}{% if site.gig %},
    {
      "@type": "Event",
      "@id": "{{ site.url }}/#gig",
      "name": {{ ("UkeHoot live at " + site.gig.venue) | dump | safe }},
      "description": "UkeHoot's monthly public gig. Come watch, sing along, heckle gently.",{% if gigWhen %}
      "startDate": "{{ gigWhen.start }}",
      "endDate": "{{ gigWhen.end }}",{% endif %}
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "isAccessibleForFree": true,
      "image": [{{ eventImage | dump | safe }}],
      "inLanguage": "{{ site.language }}",
      "organizer": { "@id": "{{ site.author.id }}" },
      "performer": { "@id": "{{ site.author.id }}" },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "GBP",
        "availability": "https://schema.org/InStock",
        "url": {{ (site.gig.url or (site.url + "/")) | dump | safe }}{% if gigWhen %},
        "validFrom": "{{ gigWhen.start }}"{% endif %}
      }{% if site.gig.venue %},
      "location": {
        "@type": "Place",
        "name": {{ site.gig.venue | dump | safe }}{% if site.gig.address %},
        "address": {{ site.gig.address | dump | safe }}{% endif %}{% if site.gig.url %},
        "url": {{ site.gig.url | dump | safe }}{% endif %}
      }{% endif %},
      "eventSchedule": {
        "@type": "Schedule",
        "byDay": "https://schema.org/Saturday",
        "byMonthWeek": 3,
        "repeatFrequency": "P1M",
        "startTime": "{{ site.gig.time | time24 }}",
        "scheduleTimezone": "Europe/London"
      }
    }{% endif %}
  ]
}
</script>

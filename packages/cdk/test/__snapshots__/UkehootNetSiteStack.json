    "ukehootnetcdnDefaultBehaviorViewerRequestFn04D62D92": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "AutoPublish": true,
        "FunctionCode": "var REDIRECTS = {};\n\nfunction handler(event) {\n  var req = event.request;\n  var host = req.headers.host && req.headers.host.value;\n  var uri = req.uri;\n\n  if (host === \"www.ukehoot.net\") {\n    return {\n      statusCode: 301,\n      statusDescription: \"Moved Permanently\",\n      headers: {\n        location: { value: \"https://ukehoot.net\" + uri }\n      }\n    };\n  }\n\n  if (REDIRECTS[uri]) {\n    return {\n      statusCode: 301,\n      statusDescription: \"Moved Permanently\",\n      headers: {\n        location: { value: REDIRECTS[uri] }\n      }\n    };\n  }\n\n  // Eleventy emits pretty URLs as <path>/index.html. CloudFront's\n  // defaultRootObject only rewrites \"/\" → \"/index.html\", so map directory-\n  // style requests onto their index file before the S3 origin sees them.\n  if (uri.endsWith(\"/\")) {\n    req.uri = uri + \"index.html\";\n  } else if (uri.lastIndexOf(\".\") < uri.lastIndexOf(\"/\")) {\n    req.uri = uri + \"/index.html\";\n  }\n\n  return req;\n}",
        "FunctionConfig": {
          "Comment": "www→apex 301 + old-URL redirect map",
          "Runtime": "cloudfront-js-2.0"
        },
        "Name": "UkehootNetSiteStack-redirect"
      }

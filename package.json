{
  "name": "ukehoot-net",
  "description": "Monorepo for ukehoot.net — infrastructure (CDK) and blog site.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.{css,html}\"",
    "lint:fix": "eslint --fix . && stylelint --fix \"**/*.{css,html}\"",
    "lint:css": "stylelint \"**/*.{css,html}\"",
    "lint:css:fix": "stylelint --fix \"**/*.{css,html}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:update": "nx run-many -t test:update",
    "build": "nx run-many -t build",
    "clean": "nx run-many -t clean",
    "cdk:synth": "nx run @ukehoot-net/cdk:synth",
    "cdk:diff": "nx run @ukehoot-net/cdk:diff",
    "cdk:deploy": "nx run @ukehoot-net/cdk:deploy",
    "cdk:deploy:stack": "nx run @ukehoot-net/cdk:deploy:stack",
    "site:check-redirects": "nx run @ukehoot-net/cdk:check:redirects",
    "site:smoke": "nx run @ukehoot-net/cdk:smoke",
    "indexnow:ping": "nx run @ukehoot-net/cdk:indexnow:ping",
    "site:build": "nx run @ukehoot-net/site:build",
    "site:start": "nx run @ukehoot-net/site:start",
    "site:clean": "nx run @ukehoot-net/site:clean",
    "verify": "npm run format:check && npm run build && npm run lint && npm run test",
    "prepare": "husky"
  },
  "author": "Jason Duffett",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "^23.1.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "nx": "^23.0.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "tmp": "^0.2.7",
    "ws": "^8.21.0",
    "@11ty/eleventy": {
      "js-yaml": "^4.2.0",
      "gray-matter": {
        "js-yaml": "^3.14.1"
      }
    },
    "babel-plugin-macros": {
      "cosmiconfig": "^9.0.0"
    }
  }
}
